{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{backup,xdr}/**"
    }
  },
  "rewrites": [
    { "source": "/api/notes/:id", "destination": "/api/notes?id=:id" },
    { "source": "/POST /api/restore", "destination": "/api/restore" },
    { "source": "/POST%20/api/restore", "destination": "/api/restore" }
  ]
}
